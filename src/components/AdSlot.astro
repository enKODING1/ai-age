---
import { KAKAO_AD } from '../consts';
---

<!-- 광고가 늦게 로드돼도 본문이 밀리지 않도록(CLS) 광고 크기만큼 자리를 미리 잡아 둔다 -->
<aside class="ad-slot" data-kakao-ad>
    <ins
        class="kakao_ad_area"
        style="display: none"
        data-ad-unit={KAKAO_AD.unit}
        data-ad-width={String(KAKAO_AD.width)}
        data-ad-height={String(KAKAO_AD.height)}
        data-ad-onfail="onKakaoAdFail"></ins>
</aside>

<script>
    // 광고 요청이 실패하거나 노출할 광고가 없으면(NO-AD) 애드핏이 ins 요소를 넘겨 호출한다.
    // 미리 잡아 둔 자리를 접어 빈 상자가 남지 않게 한다
    Object.assign(window, {
        onKakaoAdFail: (ins: HTMLElement) => ins.closest('[data-kakao-ad]')?.setAttribute('hidden', ''),
    });

    // 카카오 애드핏은 스크립트가 로드될 때 광고 영역을 찾는다.
    // SPA 전환으로 새 영역이 생기면 스크립트를 다시 붙여 광고를 채운다.
    document.addEventListener('astro:page-load', () => {
        if (!document.querySelector('[data-kakao-ad] .kakao_ad_area')) return;

        document.querySelectorAll('script[data-kakao-adfit]').forEach((el) => el.remove());
        const script = document.createElement('script');
        script.src = 'https://t1.kakaocdn.net/kas/static/ba.min.js';
        script.async = true;
        script.dataset.kakaoAdfit = '';
        document.body.append(script);
    });
</script>
