---
import Icon from './Icon.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import { localePath, t, type Locale, type LocalizedPage, type Page } from '../i18n';

interface Props {
    locale: Locale;
    page: Page;
}

const { locale, page } = Astro.props;
const d = t(locale);

// 메뉴가 3개뿐이므로 햄버거로 숨기지 않고 항상 보이게 둔다 (숨긴 내비게이션은 발견성이 떨어진다)
const links: { key: LocalizedPage; label: string }[] = [
    { key: 'home', label: d.nav.home },
    { key: 'about', label: d.nav.about },
    { key: 'privacy', label: d.nav.privacy },
];
---

<header class="site-header" transition:animate="none">
    <div class="header-bar">
        <a class="logo" href={localePath(locale)}>AI Age</a>
        <nav class="primary-nav">
            <ul>
                {
                    links.map((link) => (
                        <li>
                            <a href={localePath(locale, link.key)} aria-current={link.key === page ? 'page' : undefined}>
                                {link.label}
                            </a>
                        </li>
                    ))
                }
            </ul>
        </nav>
        <div class="header-actions">
            <LanguageSwitcher locale={locale} page={page} />
            <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label={d.ui.theme}>
                <Icon name="sun" class="icon-sun" />
                <Icon name="moon" class="icon-moon" />
            </button>
        </div>
    </div>
</header>

<script>
    document.addEventListener('astro:page-load', () => {
        const toggle = document.querySelector<HTMLElement>('[data-theme-toggle]');
        toggle?.addEventListener('click', () => {
            // 누를 때만 아이콘이 돌며 바뀌도록 (페이지 이동 때는 돌지 않음)
            toggle.dataset.animate = '';
            setTimeout(() => delete toggle.dataset.animate, 600);
            const dark = document.documentElement.dataset.theme !== 'dark';
            document.documentElement.dataset.theme = dark ? 'dark' : 'light';
            try {
                localStorage.setItem('darkMode', dark ? 'enabled' : 'disabled');
            } catch {
                // 저장소를 쓸 수 없는 환경(시크릿 모드 등)에서는 현재 페이지에만 적용
            }
        });
    });
</script>
