---
import { LOCALE_INFO, LOCALES, isLocalizedPage, localePath, t, type Locale, type Page } from '../i18n';

interface Props {
    locale: Locale;
    page: Page;
}

const { locale, page } = Astro.props;
// 한국어 전용 페이지(약관 등)에서는 각 언어의 홈으로 이동
const target = isLocalizedPage(page) ? page : 'home';
---

<!-- 국기는 언어가 아니라 나라를 뜻하므로 쓰지 않고, 각 언어를 그 언어로 쓴 이름으로 보여준다 -->
<details class="lang-switcher" data-lang-switcher>
    <summary aria-label={t(locale).ui.language}>
        <svg class="globe" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="12" cy="12" r="9"></circle>
            <path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"></path>
        </svg>
        <span class="lang-name">{LOCALE_INFO[locale].label}</span>
        <span class="lang-code">{locale.toUpperCase()}</span>
    </summary>
    <ul class="lang-menu">
        {
            LOCALES.map((l) => (
                <li>
                    <a
                        href={localePath(l, target)}
                        hreflang={LOCALE_INFO[l].htmlLang}
                        lang={LOCALE_INFO[l].htmlLang}
                        aria-current={l === locale ? 'true' : undefined}
                    >
                        {LOCALE_INFO[l].label}
                    </a>
                </li>
            ))
        }
    </ul>
</details>

<script>
    const closeSwitchers = (except?: Node) => {
        document.querySelectorAll<HTMLDetailsElement>('[data-lang-switcher][open]').forEach((el) => {
            if (!except || !el.contains(except)) el.open = false;
        });
    };

    document.addEventListener('click', (event) => closeSwitchers(event.target as Node));
    document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeSwitchers();
    });
</script>
