---
import Icon from './Icon.astro';
import { MODEL_URL, absoluteUrl } from '../consts';
import { localePath, t, type Locale } from '../i18n';

interface Props {
    locale: Locale;
}

const { locale } = Astro.props;
const d = t(locale);
const text = d.test;
const config = {
    modelUrl: MODEL_URL,
    shareUrl: absoluteUrl(localePath(locale)),
    text,
    results: d.results,
};
// "대략 {age} 세" → 숫자 부분만 카운트업 애니메이션을 주기 위해 앞뒤 문구를 나눈다
const [agePrefix, ageSuffix] = text.age.split('{age}');
---

<section class="age-test" data-age-test data-mode="upload" data-state="upload">
    <script is:inline type="application/json" data-age-test-config set:html={JSON.stringify(config)} />

    <div class="mode-tabs" role="tablist">
        <button class="mode-tab" type="button" role="tab" id="tab-upload" aria-controls="panel-upload" aria-selected="true" data-mode-tab="upload">
            <Icon name="image-square" />{text.modeUpload}
        </button>
        <button class="mode-tab" type="button" role="tab" id="tab-camera" aria-controls="panel-camera" aria-selected="false" tabindex="-1" data-mode-tab="camera">
            <Icon name="video-camera" />{text.modeCamera}
        </button>
        <span class="mode-indicator" aria-hidden="true"></span>
    </div>

    <div class="test-card">
        <div class="test-view" role="tabpanel" id="panel-upload" aria-labelledby="tab-upload" data-view="upload">
            <label class="dropzone" data-dropzone>
                <input class="file-upload-input" type="file" accept="image/*" />
                <span class="upload-icon"><Icon name="image-square" /></span>
                <span class="upload-text">{text.upload}</span>
                <span class="button button-primary" aria-hidden="true"><Icon name="upload-simple" />{text.choosePhoto}</span>
            </label>
        </div>

        <div class="test-view" role="tabpanel" id="panel-camera" aria-labelledby="tab-camera" data-view="camera" hidden>
            <div class="camera-intro" data-camera-intro>
                <span class="camera-icon"><Icon name="user-focus" /></span>
                <h2 class="camera-title">{text.cameraTitle}</h2>
                <p class="camera-text">{text.cameraText}</p>
                <p class="camera-error" data-camera-error hidden></p>
                <button class="button button-primary" type="button" data-camera-start><Icon name="video-camera" />{text.cameraStart}</button>
                <button class="button button-secondary" type="button" data-use-upload hidden>{text.useUpload}</button>
            </div>

            <div class="camera-live" data-camera-live hidden>
                <div class="camera-stage" data-camera-stage>
                    <div class="camera-mirror">
                        <video data-camera-video playsinline muted autoplay></video>
                        <canvas class="face-overlay" data-camera-overlay></canvas>
                    </div>
                    <div class="scan-line" aria-hidden="true"></div>
                    <div class="camera-loading" data-camera-loading hidden>
                        <p class="camera-loading-text">{text.loadingModel}</p>
                        <div class="load-progress" aria-hidden="true"><span></span></div>
                        <p class="load-percent" data-load-percent>0%</p>
                        <p class="load-hint">{text.loadingHint}</p>
                    </div>
                    <p class="camera-status" data-camera-status>{text.cameraStarting}</p>
                    <p class="live-age">
                        <span class="live-age-label">{text.liveLabel}</span>
                        <span class="live-age-value">{agePrefix}<strong data-live-age>--</strong>{ageSuffix}</span>
                    </p>
                </div>
                <div class="label-container live-labels" data-live-labels></div>
                <div class="button-row">
                    <button class="button button-primary" type="button" data-camera-capture disabled><Icon name="aperture" />{text.capture}</button>
                    <button class="button button-secondary" type="button" data-camera-stop><Icon name="x" />{text.cameraStop}</button>
                </div>
            </div>
        </div>

        <div class="test-view analyzing" data-view="loading" hidden>
            <div class="scan-frame">
                <img data-scan-image alt="" />
                <div class="face-box" data-scan-face hidden></div>
                <div class="scan-line" aria-hidden="true"></div>
            </div>
            <p class="analyzing-text" data-loading-text role="status">{text.loadingModel}</p>
            <div class="load-progress" data-load-progress aria-hidden="true"><span></span></div>
            <p class="load-hint" data-load-hint hidden>{text.loadingHint}</p>
        </div>

        <div class="test-view result" data-view="result" hidden>
            <div class="result-photo">
                <img data-result-image alt="" />
                <div class="face-box is-locked" data-result-face hidden></div>
            </div>
            <p class="result-label">{text.resultLabel}</p>
            <p class="prediction-age">{agePrefix}<strong data-result-age>0</strong>{ageSuffix}</p>
            <div class="description">
                <p data-result-message></p>
                <p data-result-explain></p>
            </div>
            <div class="label-container" data-result-labels></div>
            <div class="button-row">
                <button class="button button-primary" type="button" data-share><Icon name="share-network" />{text.share}</button>
                <button class="button button-secondary" type="button" data-reset>
                    <Icon name="arrow-counter-clockwise" />
                    {text.retry}
                </button>
            </div>
        </div>

        <div class="test-view error-message" data-view="error" hidden>
            <p>{text.error}</p>
            <button class="button button-secondary" type="button" data-reset>
                <Icon name="arrow-counter-clockwise" />
                {text.retry}
            </button>
        </div>
    </div>

    <p class="privacy-note"><Icon name="lock-simple" />{text.privacyNote}</p>
    <p class="toast" data-toast role="status" hidden></p>
</section>

<script>
    import { initAgeTest } from '../scripts/age-test';

    document.addEventListener('astro:page-load', initAgeTest);
</script>
