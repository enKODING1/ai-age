---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import type { IconName } from '../../icons';
import { localePath, localeStaticPaths, t, type Locale } from '../../i18n';
import { pageJsonLd } from '../../seo/jsonld';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
const a = d.about;
const FEATURE_ICONS: IconName[] = ['lightning', 'shield-check', 'device-mobile', 'sparkle'];
---

<BaseLayout
    locale={locale}
    page="about"
    title={d.meta.about.title}
    description={d.meta.about.description}
    ogTitle={d.meta.about.ogTitle}
    ogDescription={d.meta.about.ogDescription}
    jsonLd={pageJsonLd(locale, 'about')}
>
    <PageHero title={d.hero.about.title} subtitle={d.hero.about.subtitle} />

    <article class="prose-card">
        <h2>{a.title}</h2>
        <p set:html={a.intro} />

        <h3><span class="heading-icon"><Icon name="magnifying-glass" /></span>{a.how.title}</h3>
        <p set:html={a.how.lead} />
        <ul>{a.how.items.map((item) => <li set:html={item} />)}</ul>

        <div class="feature-grid">
            {
                a.features.map((feature, index) => (
                    <div class="feature-card">
                        <span class="feature-icon"><Icon name={FEATURE_ICONS[index]} /></span>
                        <h4>{feature.title}</h4>
                        <p set:html={feature.text} />
                    </div>
                ))
            }
        </div>

        <h3><span class="heading-icon"><Icon name="chart-bar" /></span>{a.results.title}</h3>
        <p set:html={a.results.lead} />
        <ul>{a.results.items.map((item) => <li set:html={item} />)}</ul>

        <h3><span class="heading-icon"><Icon name="warning" /></span>{a.caution.title}</h3>
        <ul>{a.caution.items.map((item) => <li set:html={item} />)}</ul>

        <h3><span class="heading-icon"><Icon name="cpu" /></span>{a.tech.title}</h3>
        <p set:html={a.tech.text} />

        <div class="cta-section">
            <h3>{a.cta.title}</h3>
            <p set:html={a.cta.text} />
            <a href={localePath(locale)} class="cta-button">{a.cta.button}</a>
        </div>
    </article>
</BaseLayout>
