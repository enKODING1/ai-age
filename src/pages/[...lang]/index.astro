---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import AgeTest from '../../components/AgeTest.astro';
import AdSlot from '../../components/AdSlot.astro';
import { localeStaticPaths, t, type Locale } from '../../i18n';
import { homeJsonLd } from '../../seo/jsonld';

export const getStaticPaths = localeStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const d = t(locale);
---

<BaseLayout
    locale={locale}
    page="home"
    title={d.meta.home.title}
    description={d.meta.home.description}
    ogTitle={d.meta.home.ogTitle}
    ogDescription={d.meta.home.ogDescription}
    jsonLd={homeJsonLd(locale)}
>
    <PageHero title={d.hero.home.title} subtitle={d.hero.home.subtitle} />
    <AgeTest locale={locale} />
    <AdSlot />

    <section class="home-section" id="how-it-works" aria-labelledby="how-it-works-title">
        <h2 class="section-title" id="how-it-works-title">{d.home.howTitle}</h2>
        <ol class="steps">
            {
                d.home.steps.map((step) => (
                    <li class="step">
                        <h3>{step.title}</h3>
                        <p>{step.text}</p>
                    </li>
                ))
            }
        </ol>
    </section>

    <section class="home-section" id="faq" aria-labelledby="faq-title">
        <h2 class="section-title" id="faq-title">{d.home.faqTitle}</h2>
        <div class="faq-list">
            {
                d.home.faq.map((item, index) => (
                    <details class="faq-item" open={index === 0}>
                        <summary>
                            <h3>{item.q}</h3>
                        </summary>
                        <p>{item.a}</p>
                    </details>
                ))
            }
        </div>
    </section>
</BaseLayout>
